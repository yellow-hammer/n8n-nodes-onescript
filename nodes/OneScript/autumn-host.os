#Использовать autumn
#Использовать "@@APP_PATH@@"

// Кадр — одна строка: «@@N8N » и JSON без переносов.
// Сообщить желудя в кадр не попадает.

Перем Поделка;
Перем ПотокВывода;

Функция ТекстJSON(Значение)
	Параметры = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет, " ");
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Параметры);
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция ПрочитатьКадр(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Значение = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Значение;
КонецФункции

Процедура Отправить(Запись, Значение)
	Запись.ЗаписатьСтроку("@@N8N " + ТекстJSON(Значение), , Символы.ПС);
	Запись.СброситьБуферы();
	ПотокВывода.СброситьБуферы();
КонецПроцедуры

Функция ОтветОшибки(Текст)
	Ответ = Новый Соответствие;
	Ответ.Вставить("ok", Ложь);
	Ответ.Вставить("error", ТекстОшибки(Текст));
	Возврат Ответ;
КонецФункции

Функция ТекстОшибки(Текст)
	Маркер = " / ";
	Позиция = 0;
	Найдено = СтрНайти(Текст, Маркер);
	Пока Найдено > 0 Цикл
		Позиция = Найдено;
		Найдено = СтрНайти(Текст, Маркер, , Позиция + СтрДлина(Маркер));
	КонецЦикла;

	Описание = Текст;
	Если Позиция > 0 Тогда
		Описание = Сред(Текст, Позиция + СтрДлина(Маркер));
	КонецЕсли;
	Описание = СокрЛП(Описание);
	Пока Прав(Описание, 1) = "}" Цикл
		Описание = СокрЛП(Лев(Описание, СтрДлина(Описание) - 1));
	КонецЦикла;
	Возврат Описание;
КонецФункции

Процедура ПринятьВызов(Запись, СтрокаЗапроса)
	Префикс = "@@N8N ";

	Если Лев(СтрокаЗапроса, СтрДлина(Префикс)) <> Префикс Тогда
		Отправить(Запись, ОтветОшибки("Кадр без префикса @@N8N."));
		Возврат;
	КонецЕсли;

	Попытка
		Запрос = ПрочитатьКадр(Сред(СтрокаЗапроса, СтрДлина(Префикс) + 1));
		ИмяЖелудя = Запрос["acorn"];
		Если ТипЗнч(ИмяЖелудя) <> Тип("Строка") Или ПустаяСтрока(ИмяЖелудя) Тогда
			ВызватьИсключение "В кадре нет имени желудя.";
		КонецЕсли;

		Данные = Запрос["items"];
		Если Данные = Неопределено Тогда
			Данные = Новый Массив;
		КонецЕсли;

		Попытка
			Желудь = Поделка.НайтиЖелудь(ИмяЖелудя);
		Исключение
			Отправить(Запись, ОтветОшибки(ОписаниеОшибки()));
			Возврат;
		КонецПопытки;
		Если Желудь = Неопределено Тогда
			Отправить(Запись, ОтветОшибки("Желудь «" + ИмяЖелудя + "» не создан."));
			Возврат;
		КонецЕсли;

		ПотокСообщений = Новый ПотокВПамяти;
		Консоль.УстановитьПотокВывода(ПотокСообщений);
		Попытка
			Результат = Желудь.Обработать(Данные);
			Консоль.УстановитьПотокВывода(ПотокВывода);
		Исключение
			Консоль.УстановитьПотокВывода(ПотокВывода);
			ВызватьИсключение;
		КонецПопытки;

		Ответ = Новый Соответствие;
		Ответ.Вставить("ok", Истина);
		Ответ.Вставить("body", Результат);
		Отправить(Запись, Ответ);
	Исключение
		Отправить(Запись, ОтветОшибки(ОписаниеОшибки()));
	КонецПопытки;
КонецПроцедуры

Процедура Слушать()
	Поделка = Новый Поделка;
	Поделка.ЗапуститьПриложение();

	ПотокВвода = Консоль.ОткрытьСтандартныйПотокВвода();
	ПотокВывода = Консоль.ОткрытьСтандартныйПотокВывода();
	Чтение = Новый ЧтениеДанных(ПотокВвода);
	Запись = Новый ЗаписьДанных(ПотокВывода, КодировкаТекста.UTF8, , Символы.ПС);

	Готов = Новый Соответствие;
	Готов.Вставить("ready", Истина);
	Отправить(Запись, Готов);

	Пока Истина Цикл
		СтрокаЗапроса = Чтение.ПрочитатьСтроку(КодировкаТекста.UTF8, Символы.ПС);
		Если СтрокаЗапроса = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если ПустаяСтрока(СтрокаЗапроса) Тогда
			Если Чтение.ЧтениеЗавершено Тогда
				Прервать;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		ПринятьВызов(Запись, СтрокаЗапроса);
	КонецЦикла;
КонецПроцедуры

Слушать();

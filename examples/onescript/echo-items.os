// Режим «Файл на диске». Путь к JSON — АргументыКоманднойСтроки[0].
// ПрочитатьJSON(..., Истина) кладёт объекты в Соответствие.

Если АргументыКоманднойСтроки.Количество() = 0 Тогда
	ВызватьИсключение "Нет пути к JSON. Включите «Передать входящие данные» в ноде OneScript.";
КонецЕсли;

Чтение = Новый ЧтениеJSON;
Чтение.ОткрытьФайл(АргументыКоманднойСтроки[0], "UTF-8");
ВходящиеДанные = ПрочитатьJSON(Чтение, Истина);
Чтение.Закрыть();

Запись = Новый ЗаписьJSON;
Запись.УстановитьСтроку();
ЗаписатьJSON(Запись, ВходящиеДанные);
Сообщить(Запись.Закрыть());

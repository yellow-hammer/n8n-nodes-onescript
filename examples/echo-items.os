// Пример для режима «Файл на диске».
// Нода передаёт путь к JSON первым аргументом: АргументыКоманднойСтроки[0].
// Формат файла: [ { "json": { ...поля item... } }, ... ]
// Чтение — штатные ЧтениеJSON и ПрочитатьJSON. Второй аргумент Истина
// складывает объекты JSON в Соответствие, а не в Структуру.

Если АргументыКоманднойСтроки.Количество() = 0 Тогда
	ВызватьИсключение "Нет пути к JSON. Включите «Передать входящие данные» в ноде OneScript.";
КонецЕсли;

Чтение = Новый ЧтениеJSON;
Чтение.ОткрытьФайл(АргументыКоманднойСтроки[0], "UTF-8");
ВходящиеДанные = ПрочитатьJSON(Чтение, Истина);
Чтение.Закрыть();

Запись = Новый ЗаписьJSON;
Запись.УстановитьСтроку();
ЗаписатьJSON(Запись, ВходящиеДанные);
Сообщить(Запись.Закрыть());

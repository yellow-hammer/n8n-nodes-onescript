#native

// Товар: цена уже с НДС. Услуга: цена без НДС, НДС сверху.
// Доставка бесплатна, если сумма товаров не ниже порога из ПравилаМагазина.

Перем Ставка;
Перем ПорогДоставки;

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ПравилаМагазина)
	Ставка = ПравилаМагазина.СтавкаНДС();
	ПорогДоставки = ПравилаМагазина.ПорогБесплатнойДоставки();
КонецПроцедуры

Функция Обработать(ВходящиеДанные) Экспорт
	Если ТипЗнч(ВходящиеДанные) <> Тип("Массив") Тогда
		ВызватьИсключение "Ожидался массив items.";
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Элемент Из ВходящиеДанные Цикл
		Результат.Добавить(СобратьItem(ПосчитатьЗаказ(Элемент["json"])));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СобратьItem(Заказ)
	Item = Новый Соответствие;
	Item.Вставить("json", Заказ);
	Возврат Item;
КонецФункции

Функция ПосчитатьЗаказ(Заказ)
	Если ТипЗнч(Заказ) <> Тип("Соответствие") Тогда
		ВызватьИсключение "У item нет объекта json.";
	КонецЕсли;

	СтрокиЗаказа = Заказ["lines"];
	Если ТипЗнч(СтрокиЗаказа) <> Тип("Массив") Тогда
		ВызватьИсключение "В заказе " + ПредставлениеНомера(Заказ) + " нет массива lines.";
	КонецЕсли;

	Черновики = Новый Массив;
	СуммаТоваров = 0;
	Для Каждого СтрокаЗаказа Из СтрокиЗаказа Цикл
		Вид = ВидСтроки(СтрокаЗаказа, Заказ);
		Если Вид = "delivery" Тогда
			Черновики.Добавить(Неопределено);
		Иначе
			Посчитанная = ПосчитатьСтроку(СтрокаЗаказа, Заказ, Вид, 0);
			Черновики.Добавить(Посчитанная);
			Если Вид = "goods" Тогда
				СуммаТоваров = СуммаТоваров + Посчитанная["grossKopeks"];
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Строки = Новый Массив;
	Индекс = 0;
	Для Каждого СтрокаЗаказа Из СтрокиЗаказа Цикл
		Если ВидСтроки(СтрокаЗаказа, Заказ) = "delivery" Тогда
			Строки.Добавить(ПосчитатьСтроку(СтрокаЗаказа, Заказ, "delivery", СуммаТоваров));
		Иначе
			Строки.Добавить(Черновики[Индекс]);
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;

	Итог = Новый Соответствие;
	Для Каждого Пара Из Заказ Цикл
		Если Пара.Ключ <> "lines" Тогда
			Итог.Вставить(Пара.Ключ, Пара.Значение);
		КонецЕсли;
	КонецЦикла;
	Итог.Вставить("lines", БезКопеек(Строки));
	Итог.Вставить("totalGross", Рубли(СуммаПоля(Строки, "grossKopeks")));
	Итог.Вставить("totalVat", Рубли(СуммаПоля(Строки, "vatKopeks")));
	Итог.Вставить("totalNet", Рубли(СуммаПоля(Строки, "netKopeks")));
	Возврат Итог;
КонецФункции

Функция ВидСтроки(СтрокаЗаказа, Заказ)
	Если ТипЗнч(СтрокаЗаказа) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Строка заказа " + ПредставлениеНомера(Заказ) + " не является объектом.";
	КонецЕсли;
	Вид = СтрокаЗаказа["type"];
	Если Вид <> "goods" И Вид <> "service" И Вид <> "delivery" Тогда
		ВызватьИсключение "Неизвестный type в заказе " + ПредставлениеНомера(Заказ) + ".";
	КонецЕсли;
	Возврат Вид;
КонецФункции

Функция ПосчитатьСтроку(СтрокаЗаказа, Заказ, Вид, СуммаТоваров)
	Сумма = СуммаПослеСкидки(СтрокаЗаказа, Заказ);
	Ветка = Вид;
	Если Вид = "delivery" И СуммаТоваров >= КопейкиИзРублей(ПорогДоставки) Тогда
		Сумма = 0;
		Ветка = "delivery-free";
	КонецЕсли;

	Если Вид = "service" Тогда
		НДС = РазделитьСОкруглением(Сумма * Ставка, 100);
		ИтогСтроки = Сумма + НДС;
		БезНДС = Сумма;
	Иначе
		ИтогСтроки = Сумма;
		НДС = РазделитьСОкруглением(Сумма * Ставка, 100 + Ставка);
		БезНДС = Сумма - НДС;
	КонецЕсли;

	Посчитанная = Новый Соответствие;
	Для Каждого Пара Из СтрокаЗаказа Цикл
		Посчитанная.Вставить(Пара.Ключ, Пара.Значение);
	КонецЦикла;
	Посчитанная.Вставить("branch", Ветка);
	Посчитанная.Вставить("grossKopeks", ИтогСтроки);
	Посчитанная.Вставить("vatKopeks", НДС);
	Посчитанная.Вставить("netKopeks", БезНДС);
	Возврат Посчитанная;
КонецФункции

Функция СуммаПослеСкидки(СтрокаЗаказа, Заказ)
	Если СтрокаЗаказа["price"] = Неопределено Или СтрокаЗаказа["qty"] = Неопределено Тогда
		ВызватьИсключение "В строке заказа " + ПредставлениеНомера(Заказ) + " нужны price и qty.";
	КонецЕсли;

	Цена = Число(СтрокаЗаказа["price"]);
	Количество = Число(СтрокаЗаказа["qty"]);
	Процент = Число(?(СтрокаЗаказа["discountPercent"] = Неопределено, 0, СтрокаЗаказа["discountPercent"]));
	Если Количество <= 0 Тогда
		ВызватьИсключение "Количество в заказе " + ПредставлениеНомера(Заказ) + " должно быть больше нуля.";
	КонецЕсли;
	Если Цена < 0 Тогда
		ВызватьИсключение "Цена в заказе " + ПредставлениеНомера(Заказ) + " не может быть отрицательной.";
	КонецЕсли;
	Если Процент < 0 Или Процент > 100 Тогда
		ВызватьИсключение "Скидка в заказе " + ПредставлениеНомера(Заказ) + " должна быть от 0 до 100.";
	КонецЕсли;

	СуммаДоСкидки = КопейкиИзРублей(Цена * Количество);
	Скидка = РазделитьСОкруглением(СуммаДоСкидки * Процент, 100);
	Возврат СуммаДоСкидки - Скидка;
КонецФункции

Функция БезКопеек(Строки)
	Видимые = Новый Массив;
	Для Каждого СтрокаЗаказа Из Строки Цикл
		Видимая = Новый Соответствие;
		Для Каждого Пара Из СтрокаЗаказа Цикл
			Если Пара.Ключ <> "grossKopeks" И Пара.Ключ <> "vatKopeks" И Пара.Ключ <> "netKopeks" Тогда
				Видимая.Вставить(Пара.Ключ, Пара.Значение);
			КонецЕсли;
		КонецЦикла;
		Видимая.Вставить("gross", Рубли(СтрокаЗаказа["grossKopeks"]));
		Видимая.Вставить("vat", Рубли(СтрокаЗаказа["vatKopeks"]));
		Видимая.Вставить("net", Рубли(СтрокаЗаказа["netKopeks"]));
		Видимые.Добавить(Видимая);
	КонецЦикла;
	Возврат Видимые;
КонецФункции

Функция СуммаПоля(Строки, ИмяПоля)
	Сумма = 0;
	Для Каждого СтрокаЗаказа Из Строки Цикл
		Сумма = Сумма + СтрокаЗаказа[ИмяПоля];
	КонецЦикла;
	Возврат Сумма;
КонецФункции

Функция ПредставлениеНомера(Заказ)
	Номер = Заказ["orderId"];
	Если Номер = Неопределено Тогда
		Возврат "без номера";
	КонецЕсли;
	Возврат Строка(Номер);
КонецФункции

Функция КопейкиИзРублей(Сумма)
	Возврат Цел(Сумма * 100 + 0.5);
КонецФункции

Функция РазделитьСОкруглением(Числитель, Знаменатель)
	Возврат Цел((Числитель + Цел(Знаменатель / 2)) / Знаменатель);
КонецФункции

Функция Рубли(Копейки)
	Возврат Копейки / 100;
КонецФункции

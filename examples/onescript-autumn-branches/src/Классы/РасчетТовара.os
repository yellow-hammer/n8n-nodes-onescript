#native

Перем Ставка;

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин ПравилаМагазина)
	Ставка = ПравилаМагазина.СтавкаНДС();
КонецПроцедуры

Функция Обработать(ВходящиеДанные) Экспорт
	Результат = Новый Массив;
	Для Каждого Элемент Из ВходящиеДанные Цикл
		Данные = Элемент["json"];
		Процент = Число(?(Данные["discountPercent"] = Неопределено, 0, Данные["discountPercent"]));
		Сумма = Деньги.ПослеСкидки(Число(Данные["price"]), Число(Данные["qty"]), Процент);
		НДС = Деньги.ОкруглитьДеление(Сумма * Ставка, 100 + Ставка);
		Данные.Вставить("branch", "goods");
		Данные.Вставить("gross", Деньги.Рубли(Сумма));
		Данные.Вставить("vat", Деньги.Рубли(НДС));
		Данные.Вставить("net", Деньги.Рубли(Сумма - НДС));
		Item = Новый Соответствие;
		Item.Вставить("json", Данные);
		Результат.Добавить(Item);
	КонецЦикла;
	Возврат Результат;
КонецФункции

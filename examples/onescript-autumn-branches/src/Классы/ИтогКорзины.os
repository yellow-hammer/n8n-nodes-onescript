#native

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

Функция Обработать(ВходящиеДанные) Экспорт
	Если ВходящиеДанные.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Первая = ВходящиеДанные[0]["json"];
	Строки = Новый Массив;
	Сумма = 0;
	НДС = 0;
	БезНДС = 0;
	Для Каждого Элемент Из ВходящиеДанные Цикл
		Данные = Элемент["json"];
		Строки.Добавить(Данные);
		Сумма = Сумма + Число(Данные["gross"]);
		НДС = НДС + Число(Данные["vat"]);
		БезНДС = БезНДС + Число(Данные["net"]);
	КонецЦикла;

	Итог = Новый Соответствие;
	Итог.Вставить("orderId", Первая["orderId"]);
	Итог.Вставить("customer", Первая["customer"]);
	Итог.Вставить("lines", Строки);
	Итог.Вставить("totalGross", Сумма);
	Итог.Вставить("totalVat", НДС);
	Итог.Вставить("totalNet", БезНДС);
	Item = Новый Соответствие;
	Item.Вставить("json", Итог);
	Результат = Новый Массив;
	Результат.Добавить(Item);
	Возврат Результат;
КонецФункции

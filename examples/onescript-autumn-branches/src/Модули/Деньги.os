Функция Копейки(Сумма) Экспорт
	Возврат Цел(Сумма * 100 + 0.5);
КонецФункции

Функция Рубли(Копейки) Экспорт
	Возврат Копейки / 100;
КонецФункции

Функция ОкруглитьДеление(Числитель, Знаменатель) Экспорт
	Возврат Цел((Числитель + Цел(Знаменатель / 2)) / Знаменатель);
КонецФункции

Функция ПослеСкидки(Цена, Количество, Процент) Экспорт
	СуммаДоСкидки = Копейки(Цена * Количество);
	Скидка = ОкруглитьДеление(СуммаДоСкидки * Процент, 100);
	Возврат СуммаДоСкидки - Скидка;
КонецФункции
